# 6. New animated ocean renderer
renderer = r"""
// LOVE DIVE: animated ocean and scuba diver.
const canvas = $('#ocean');
const c = canvas.getContext('2d');
const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

let w = innerWidth;
let h = innerHeight;
let sceneTime = 0;
let last = 0;
let surfaceY = 0;
let diveStartedAt = 0;
let visualDepth = 0;

function resize(){
    w = innerWidth;
    h = innerHeight;

    const dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.round(w * dpr);
    canvas.height = Math.round(h * dpr);
    c.setTransform(dpr, 0, 0, dpr, 0, 0);

    if (!surfaceY) surfaceY = h * .52;
}

window.addEventListener('resize', resize);
resize();

function polygon(points, fill){
    c.beginPath();

    points.forEach(([x, y], i) => {
        if (i === 0) c.moveTo(x, y);
        else c.lineTo(x, y);
    });

    c.closePath();
    c.fillStyle = fill;
    c.fill();
}

function drawBoat(x, y, t){
    c.save();
    c.translate(x, y + (reduced ? 0 : Math.sin(t * .001) * 2));

    polygon(
        [[-48,0],[48,0],[32,13],[-32,13]],
        '#173e50'
    );

    c.strokeStyle = '#e8f2ed';
    c.lineWidth = 2;
    c.beginPath();
    c.moveTo(-47, 2);
    c.quadraticCurveTo(0, 17, 47, 2);
    c.stroke();

    c.strokeStyle = '#f5f3e9';
    c.beginPath();
    c.moveTo(0, 0);
    c.lineTo(0, -67);
    c.stroke();

    polygon([[4,-62],[4,-8],[39,-8]], '#fff9ee');
    polygon([[-4,-52],[-4,-9],[-34,-9]], '#e9b9ad');

    c.restore();
}

function drawDiver(x, y, angle, scale, t){
    c.save();
    c.translate(x, y);
    c.rotate(angle);
    c.scale(scale, scale);

    // Oxygen tank
    c.fillStyle = '#e4b878';
    c.beginPath();
    c.roundRect(-19, -13, 15, 26, 6);
    c.fill();

    // Body
    c.fillStyle = '#f0c5b2';
    c.beginPath();
    c.ellipse(2, 0, 20, 9, 0, 0, Math.PI * 2);
    c.fill();

    c.fillStyle = '#28556b';
    c.beginPath();
    c.ellipse(3, 0, 15, 7, 0, 0, Math.PI * 2);
    c.fill();

    // Arms and legs
    c.strokeStyle = '#f0c5b2';
    c.lineWidth = 5;
    c.lineCap = 'round';

    c.beginPath();
    c.moveTo(6, -4);
    c.quadraticCurveTo(17, -16, 27, -12);
    c.stroke();

    c.beginPath();
    c.moveTo(7, 4);
    c.quadraticCurveTo(18, 14, 27, 10);
    c.stroke();

    c.beginPath();
    c.moveTo(-7, -5);
    c.lineTo(-24, -15);
    c.stroke();

    c.beginPath();
    c.moveTo(-7, 5);
    c.lineTo(-24, 15);
    c.stroke();

    // Fins
    polygon([[-22,-15],[-35,-20],[-31,-10],[-23,-8]], '#79bbc2');
    polygon([[-22,15],[-35,20],[-31,10],[-23,8]], '#79bbc2');

    // Head and mask
    c.fillStyle = '#e7b69e';
    c.beginPath();
    c.arc(24, 0, 10, 0, Math.PI * 2);
    c.fill();

    c.fillStyle = '#8ed0d4';
    c.beginPath();
    c.roundRect(26, -7, 11, 8, 3);
    c.fill();

    c.strokeStyle = '#f7eee0';
    c.lineWidth = 2;
    c.strokeRect(27, -6, 9, 6);

    // Bubbles
    c.strokeStyle = 'rgba(221,250,247,.8)';
    c.lineWidth = 1.5;

    for (let i = 0; i < 3; i++){
        const bx = 35 + (
            reduced ? 0 : Math.sin(t * .003 + i) * 3
        );

        const by = -15 - i * 9 - (
            reduced ? 0 : (t * .012) % 8
        );

        c.beginPath();
        c.arc(bx, by, 2 + i * .5, 0, Math.PI * 2);
        c.stroke();
    }

    c.restore();
}

function draw(t){
    const dt = Math.min(40, t - last || 16);
    last = t;

    if (!reduced) sceneTime += dt;

    const target = typeof targetDepth === 'number'
        ? targetDepth
        : 0;

    visualDepth += (
        target - visualDepth
    ) * (reduced ? 1 : .035);

    if (Math.abs(target - visualDepth) < .1){
        visualDepth = target;
    }

    const desired = screen === 'home'
        ? h * .52
        : screen === 'results'
            ? h * .36
            : h * .22 - Math.min(visualDepth, 20000) * .0035;

    surfaceY += (desired - surfaceY) * (reduced ? 1 : .045);

    const deep = Math.min(1, visualDepth / 6500);
    const sea = c.createLinearGradient(0, 0, 0, h);

    sea.addColorStop(
        0,
        `rgb(${Math.round(28-deep*18)},${Math.round(105-deep*70)},${Math.round(132-deep*79)})`
    );

    sea.addColorStop(
        1,
        `rgb(${Math.round(8-deep*5)},${Math.round(42-deep*28)},${Math.round(66-deep*38)})`
    );

    c.fillStyle = sea;
    c.fillRect(0, 0, w, h);

    // Sky
    if (surfaceY > 0){
        const sky = c.createLinearGradient(
            0, 0, 0, Math.max(1, surfaceY)
        );

        sky.addColorStop(0, '#9bcbd4');
        sky.addColorStop(1, '#edf3e9');

        c.fillStyle = sky;
        c.fillRect(0, 0, w, surfaceY + 2);

        c.fillStyle = '#f5dcaa';
        c.beginPath();
        c.arc(w * .78, Math.max(42, surfaceY * .34), 24, 0, Math.PI * 2);
        c.fill();

        c.strokeStyle = 'rgba(244,255,250,.55)';
        c.lineWidth = 2;
        c.beginPath();

        for (let x = 0; x <= w; x += 8){
            const y = surfaceY + (
                reduced ? 0 : Math.sin(x * .025 + sceneTime * .001) * 2
            );

            if (x === 0) c.moveTo(x, y);
            else c.lineTo(x, y);
        }

        c.stroke();
    }

    const boatX = w * .25;
    drawBoat(boatX, surfaceY, sceneTime);

    let dx = w * .76;
    let dy = surfaceY - 28;
    let angle = 0;

    if (screen === 'play'){
        const elapsed = reduced
            ? 2400
            : Math.max(0, t - diveStartedAt);

        const p = Math.min(1, elapsed / 2200);
        const ease = p * p * (3 - 2 * p);

        const underwaterY = Math.max(surfaceY + 65, h * .49)
            + Math.min(visualDepth * .045, h * .32);

        dx = boatX + 35 + (w * .76 - boatX - 35) * ease;
        dy = surfaceY - 30 + (
            underwaterY - (surfaceY - 30)
        ) * ease;

        angle = (1 - ease) * -.75
            + (reduced ? 0 : Math.sin(p * Math.PI) * .38);
    }

    if (screen === 'results') dy = surfaceY + 12;
    if (screen === 'home') dy = surfaceY - 28;

    dy = Math.max(35, Math.min(h - 45, dy));

    drawDiver(
        dx,
        dy,
        angle,
        Math.max(.72, Math.min(1, w / 900)),
        sceneTime
    );

    const vignette = c.createLinearGradient(0, 0, 0, h);
    vignette.addColorStop(0, 'rgba(6,25,43,0)');
    vignette.addColorStop(1, 'rgba(4,20,37,.45)');

    c.fillStyle = vignette;
    c.fillRect(0, 0, w, h);

    requestAnimationFrame(draw);
}

requestAnimationFrame(draw);
home();
"""

# Replace the old renderer and everything after it.
source = source[:renderer_start] + renderer


