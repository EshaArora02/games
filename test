path = Path("/workspaces/games/testgame.html")

if not path.is_file():
    raise FileNotFoundError(f"HTML file not found: {path}")

source = path.read_text(encoding="utf-8")
original_source = source


def replace_once(old, new, required=True):
    global source

    if old not in source:
        if required:
            raise ValueError(
                f"Could not find expected text:\n{old[:180]!r}"
            )
        print(f"Notice: skipped missing text: {old[:100]!r}")
        return

    source = source.replace(old, new, 1)


def replace_between(start, end, replacement):
    global source

    a = source.find(start)
    if a == -1:
        raise ValueError(f"Start marker not found: {start!r}")

    b = source.find(end, a + len(start))
    if b == -1:
        raise ValueError(f"End marker not found: {end!r}")

    source = source[:a] + replacement + source[b:]


