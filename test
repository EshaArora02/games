if "</style>" not in source:
    raise ValueError("Could not find </style>. No changes have been saved.")

source = source.replace("</style>", styles + "\n</style>", 1)


# 8. Validate and save
if source == original_source:
    raise RuntimeError("No changes were made.")

if "requestAnimationFrame(frame)" in source:
    raise ValueError("Old animation loop remains. No changes have been saved.")

if "function draw(t)" not in source:
    raise ValueError("New renderer is missing.")

if "requestAnimationFrame(draw);" not in source:
    raise ValueError("New renderer initialization is missing.")
backup = path.with_suffix(".html.bak")
shutil.copy2(path, backup)
path.write_text(source, encoding="utf-8")

